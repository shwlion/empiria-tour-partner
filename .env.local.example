# Empiria Tour — Partner dashboard.
# Paste from Supabase → Project Settings → API, for the TOURS project
# (wnaleobzkoukdzlruouu). Never the Empiria-01 project.

# Session auth. Safe to expose: RLS applies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role. SERVER ONLY, no NEXT_PUBLIC_ prefix, never committed.
# A partner's own draft tours are invisible to the anon role, so this app needs
# it — and therefore every query here filters on packages.partner_id in code.
# Without the key the app opens but refuses to save.
SUPABASE_URL=
SUPABASE_KEY=
